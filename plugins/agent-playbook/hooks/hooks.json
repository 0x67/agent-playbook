{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.py\" AGENTS.md", "timeout": 5 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.py\" hooks/humanizer-card.md", "timeout": 5 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lat-stop.py\"", "timeout": 30 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.py\" AGENTS.md", "timeout": 5 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.py\" hooks/humanizer-card.md", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lat-context-reminder.py\"", "timeout": 5 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/memory-search-reminder.py\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/prose-check/scripts/run.sh\" prose_check.py", "timeout": 30, "statusMessage": "Checking prose for AI patterns..." }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/prose-check/scripts/run.sh\" send_guard.py", "if": "Bash(git commit *)", "timeout": 30, "statusMessage": "Checking message prose..." },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/prose-check/scripts/run.sh\" send_guard.py", "if": "Bash(gh pr *)", "timeout": 30, "statusMessage": "Checking message prose..." },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/prose-check/scripts/run.sh\" send_guard.py", "if": "Bash(gh issue *)", "timeout": 30, "statusMessage": "Checking message prose..." }
        ]
      },
      {
        "matcher": "Artifact|mcp__.*Claude_Docs__(batch|update|create)|mcp__.*Google_(Docs|Slides)__.*(create|update|batch|insert|replace|append|write).*",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/prose-check/scripts/run.sh\" send_guard.py", "timeout": 60, "statusMessage": "Checking prose before publishing..." }
        ]
      },
      {
        "matcher": "mcp__.*__(slack_send_message|slack_send_message_draft|slack_schedule_message|slack_create_canvas|slack_update_canvas|addOrEditJiraIssueComment|createJiraIssue|editJiraIssue|createConfluenceContent|updateConfluenceContent|send_message|create_draft|update_draft|reply|forward|notion-create-pages|notion-update-page|notion-create-comment|notion-update-comment)",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/prose-check/scripts/run.sh\" send_guard.py", "timeout": 30, "statusMessage": "Checking message prose..." }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/lang-skill-reminder.sh\"", "timeout": 5, "statusMessage": "Checking for Go/Rust/C++/JVM edits..." }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/security-guard.py\"", "timeout": 120, "statusMessage": "Checking dependencies, installs, secrets, and deploys..." }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lat-stop.py\"", "timeout": 60 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/lat-stop.py\"", "timeout": 5 }
        ]
      }
    ]
  }
}
